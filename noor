name: Build Noor APK
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - name: Unpack
        run: unzip -q project.zip -d app
      - name: Install
        working-directory: app
        run: |
          npm install --legacy-peer-deps
          npm install @capacitor-community/speech-recognition@6 --legacy-peer-deps || echo "speech skipped"
      - name: Build
        working-directory: app
        run: |
          npx cap add android
          python3 scripts/patch.py
          npx cap sync android
          cd android && chmod +x gradlew && ./gradlew assembleDebug --no-daemon
      - uses: actions/upload-artifact@v4
        with:
          name: noor-apk
          path: app/android/app/build/outputs/apk/debug/app-debug.apk
